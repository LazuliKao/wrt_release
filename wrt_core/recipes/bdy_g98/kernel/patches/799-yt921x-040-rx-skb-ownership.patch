Subject: [PATCH] net: dsa: yt921x: leave rejected RX skb to DSA core

The receive callback returns NULL for malformed tags and unknown source
ports. dsa_switch_rcv() frees the original skb when the callback returns
NULL, so freeing it in the callback causes a double free. This can panic
in kfree_skbmem()/__slab_free() from the receive softirq.

Keep all validation and diagnostics, but leave the rejected skb owned by
the DSA caller. This fixes all four rejection paths in the pinned YT921x
backport; it is independent of the stmmac TX offload follow-up.

--- a/net/dsa/tag_yt921x.c
+++ b/net/dsa/tag_yt921x.c
@@ -108,7 +108,6 @@ yt921x_tag_rcv(struct sk_buff *skb, struct net_device *netdev)
 	u16 rx;
 
 	if (unlikely(!pskb_may_pull(skb, YT921X_TAG_LEN))) {
-		kfree_skb(skb);
 		return NULL;
 	}
 
@@ -119,7 +118,6 @@ yt921x_tag_rcv(struct sk_buff *skb, struct net_device *netdev)
 		dev_warn_ratelimited(&netdev->dev,
 				     "Unexpected EtherType 0x%04x\n",
 				     ntohs(tag[0]));
-		kfree_skb(skb);
 		return NULL;
 	}
 
@@ -128,7 +126,6 @@ yt921x_tag_rcv(struct sk_buff *skb, struct net_device *netdev)
 	if (unlikely((rx & YT921X_TAG_PORT_EN) == 0)) {
 		dev_warn_ratelimited(&netdev->dev,
 				     "Unexpected rx tag 0x%04x\n", rx);
-		kfree_skb(skb);
 		return NULL;
 	}
 
@@ -137,7 +134,6 @@ yt921x_tag_rcv(struct sk_buff *skb, struct net_device *netdev)
 	if (unlikely(!skb->dev)) {
 		dev_warn_ratelimited(&netdev->dev,
 				     "Couldn't decode source port %u\n", port);
-		kfree_skb(skb);
 		return NULL;
 	}
 
