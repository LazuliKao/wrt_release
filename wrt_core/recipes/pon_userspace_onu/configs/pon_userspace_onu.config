# 替换为 naoki66/OpenWrt_ONU_CONFIG 提供的 ONU 用户态 PON 栈与插件
# CONFIG_PACKAGE_luci-app-pon is not set
# CONFIG_PACKAGE_luci-i18n-pon-zh-cn is not set
# CONFIG_PACKAGE_luci-app-iptv is not set
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-pon-debug=y
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-i18n-onu-zh-cn=y
CONFIG_PACKAGE_luci-app-pon-status=y
