{
  "$schema": "../recipe.schema.json",
  "name": "luci_app_qosify",
  "description": "开启 luci-app-qosify 和 qosify (从官方 upstream master 分支获取最新包定义)",
  "enabled": false,
  "phase": "pre_defconfig",
  "depends": [],
  "conflicts": [],
  "tags": [
    "qos",
    "qosify",
    "luci",
    "network"
  ],
  "when": {
    "targets": [],
    "repo": [],
    "branch": [],
    "tags": []
  },
  "actions": {
    "addFeeds": [],
    "removeFeeds": [],
    "importPackagesRegistry": {
      "openwrt-luci-master": {
        "gitUrl": "https://github.com/openwrt/luci.git",
        "branch": "master",
        "depth": 1
      },
      "openwrt-main": {
        "gitUrl": "https://github.com/openwrt/openwrt.git",
        "branch": "main",
        "depth": 1
      }
    },
    "importPackages": [
      {
        "source": "openwrt-main",
        "path": "package/network/config/qosify",
        "packageName": "qosify"
      },
      {
        "source": "openwrt-luci-master",
        "path": "applications/luci-app-qosify",
        "packageName": "luci-app-qosify",
        "fixLuciMk": true
      }
    ],
    "removePackageDirs": [
      "package/network/config/qosify",
      "feeds/packages/net/qosify",
      "feeds/luci/applications/luci-app-qosify",
      "package/feeds/packages/qosify",
      "package/feeds/luci/luci-app-qosify"
    ],
    "patches": [],
    "files": [],
    "configs": [
      "configs/luci_app_qosify.config"
    ],
    "script": null
  }
}
