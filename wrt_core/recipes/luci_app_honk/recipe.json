{
  "$schema": "../recipe.schema.json",
  "name": "luci_app_honk",
  "description": "导入 QiuSimons 的 honk eBPF 透明代理与 luci-app-honk 控制面板",
  "enabled": false,
  "phase": "pre_defconfig",
  "depends": [],
  "conflicts": [],
  "tags": [
    "proxy",
    "luci",
    "honk"
  ],
  "when": {
    "targets": [],
    "repo": [],
    "branch": [],
    "tags": []
  },
  "actions": {
    "addFeeds": [],
    "removeFeeds": [],
    "importPackagesRegistry": {
      "luci-app-honk": {
        "gitUrl": "https://github.com/QiuSimons/luci-app-honk.git",
        "branch": "master",
        "sparseRoot": null
      },
      "vmlinux-btf": {
        "gitUrl": "https://github.com/QiuSimons/vmlinux-btf.git",
