CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_ruijie_rg-x60-pro=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_ruijie_rg-x60-pro-107m=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_supergateway_s20l=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_supergateway_s20m=y
